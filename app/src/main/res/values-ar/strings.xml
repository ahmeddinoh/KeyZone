    <!-- Welcome Screen -->
    <string name="welcome_press_back">اضغط على زر الرجوع مرة أخرى للخروج</string>
    <string name="welcome_create_vault">إنشاء خزنة جديدة</string>
    <string name="welcome_import_vault">استيراد خزنة موجودة</string>
    <string name="welcome_page1_line1">مغلق بإحكام،</string>
    <string name="welcome_page1_line2">على جهازك.</string>
    <string name="welcome_page1_body">يتم تشفير كل ملف باستخدام AES-256-GCM قبل دخوله إلى الخزنة.</string>
    <string name="welcome_page2_line1">مفتاح واحد،</string>
    <string name="welcome_page2_line2">لك وحدك.</string>
    <string name="welcome_page2_body">يستمد رقم التعريف الشخصي أو كلمة المرور الخاصة بك المفتاح الرئيسي باستخدام PBKDF2 (150 ألف دورة). فتح القفل بالبصمة اختياري.</string>
    <string name="welcome_page3_line1">قفل ثانٍ،</string>
    <string name="welcome_page3_line2">إذا أردت ذلك.</string>
    <string name="welcome_page3_body">أضف تطبيق مصادقة لرمز مكون من 6 أرقام، بالإضافة إلى 8 رموز استرداد للطوارئ.</string>
    <string name="welcome_page4_line1">ملفاتك، ملاحظاتك،</string>
    <string name="welcome_page4_line2">وتسجيلات الدخول.</string>
    <string name="welcome_page4_body">احتفظ بها معاً، ثم ابحث وصنف وأضف علامات وعاينها دون مغادرة التطبيق.</string>
    <string name="welcome_page5_line1">خذها</string>
    <string name="welcome_page5_line2">معك.</string>
    <string name="welcome_page5_body">قم بالنسخ الاحتياطي إلى أرشيف .cvault واستورده على أي هاتف جديد. تبقى الملفات مشفرة بالداخل.</string>

